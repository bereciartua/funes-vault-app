<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Keys Xcode can't generate from build settings; merged with the generated Info.plist
     (GENERATE_INFOPLIST_FILE). spec/plans/project-setup.md "Info.plist highlights". -->
<dict>
	<!-- Sparkle: the latest published release's appcast, and Funes's own EdDSA public key (the
	     private key is in the maintainer's login keychain as account funes-vault, and the
	     SPARKLE_PRIVATE_KEY secret). Never change SUPublicEDKey in a release: installed copies
	     only accept updates signed with the key they shipped with (docs/MAINTAINING.md, Updates).
	     Only a copy signed with Funes's Developer ID checks for updates (SparkleUpdater.isConfigured):
	     a build from source never does, though it has both keys. -->
	<key>SUFeedURL</key>
	<string>https://github.com/bereciartua/funes-vault-app/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>oFIltO+F0B34afueMjZjzPhGfSgO12GLQ99IDGFXQ0g=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
	<!-- iPhone access (task 5.2): macOS asks for Local Network access before the companion
	     listener advertises _funes._tcp over Bonjour. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Funes Vault listens for your paired iPhone on your local network, so it can send captures and reach your vault.</string>
	<!-- Dictation in the capture box and Home's composer (FR-H-03): SpeechAnalyzer, on this Mac. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Funes Vault listens while you dictate a memory, only after you click the microphone.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Funes Vault turns what you dictate into text on this Mac, for the memory you're writing.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_funes._tcp</string>
	</array>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Remember in Funes</string>
			</dict>
			<key>NSMessage</key>
			<string>rememberInFunes</string>
			<key>NSPortName</key>
			<string>Funes Vault</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendTypes</key>
			<array>
				<string>NSStringPboardType</string>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
