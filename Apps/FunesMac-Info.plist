<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Keys Xcode can't generate from build settings; merged with the generated Info.plist
     (GENERATE_INFOPLIST_FILE). spec/plans/project-setup.md "Info.plist highlights". -->
<dict>
	<!-- TODO(release): Sparkle's feed and EdDSA public key are left empty until the user creates
	     Funes's own key pair at release time (spec/plans/project-setup.md: SUFeedURL is
	     https://github.com/bereciartua/funes-vault-app/releases/latest/download/appcast.xml).
	     While either is empty, the app never checks for updates. -->
	<key>SUFeedURL</key>
	<string></string>
	<key>SUPublicEDKey</key>
	<string></string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Remember in Funes</string>
			</dict>
			<key>NSMessage</key>
			<string>rememberInFunes</string>
			<key>NSPortName</key>
			<string>Funes Vault</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendTypes</key>
			<array>
				<string>NSStringPboardType</string>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
